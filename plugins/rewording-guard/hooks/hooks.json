{
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "rewording|rewording:rewording",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/precheck.py\" hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
